// =============================================================================
// doGet(e) — main entry point
// =============================================================================
function doGet(e) {

  // 🔐 API KEY CHECK
  if (!e.parameter.key || e.parameter.key !== API_KEY) {
    return jsonResponse({ error: "Unauthorized" });
  }

  // =========================================================
  // 1. CREATE SHARE
  // =========================================================
  if (e.parameter.data) {
    try {
      const data = JSON.parse(decodeURIComponent(e.parameter.data));

      // ✅ STRICT CHECK
      if (data.action === "createShare" && data.carId) {

        const shareId = Utilities.getUuid().substring(0, 8);

        const props = PropertiesService.getScriptProperties();

        props.setProperty('share_' + shareId, JSON.stringify({
          carId: data.carId,
          expiry: new Date().getTime() + (SHARE_EXPIRY_DAYS * 86400000)
        }));

        return jsonResponse({ success: true, shareId: shareId });
      }

      // 🔴 IMPORTANT: always return something
      return jsonResponse({
        error: "Invalid action or missing carId",
        received: data
      });

    } catch (err) {
      return jsonResponse({
        error: "createShare failed",
        details: err.toString()
      });
    }
  }

  // =========================================================
  // 2. FETCH SHARE
  // =========================================================
  if (e.parameter.share) {
    try {
      const props = PropertiesService.getScriptProperties();
      const raw = props.getProperty('share_' + e.parameter.share);

      if (!raw) return jsonResponse({ error: "not_found" });

      const data = JSON.parse(raw);

      if (new Date().getTime() > data.expiry) {
        props.deleteProperty('share_' + e.parameter.share);
        return jsonResponse({ error: "expired" });
      }

      const carId = data.carId;

      // 🔥 Fetch latest data from sheet
      const ss = SpreadsheetApp.openById(SHEET_ID);
      const sheet = ss.getSheetByName(INVENTORY_SHEET);
      const rows = sheet.getDataRange().getValues();

      let car = null;

      for (let i = 1; i < rows.length; i++) {
        if (String(rows[i][1]) === String(carId)) {
          car = {
            id: rows[i][1],
            brand: rows[i][2],
            model: rows[i][3],
            variant: rows[i][4],
            price: rows[i][5],
            color: rows[i][6],
            year: rows[i][7],
            fuel: rows[i][8],
            km: rows[i][9],
            owner: rows[i][10],
            tpExpiry: formatSheetDate(rows[i][11]),
            odExpiry: formatSheetDate(rows[i][12]),
            idv: rows[i][13],
            showroom: String(rows[i][14]).toLowerCase().includes("yes"),
            images: rows[i][15]
          };
          break;
        }
      }

      if (!car) return jsonResponse({ error: "not_found" });

      return jsonResponse({
        car: car,
        images: car.images ? car.images.split(",") : []
      });

    } catch (err) {
      return jsonResponse({ error: "fetchShare failed: " + err });
    }
  }

  // =========================================================
  // 3. NORMAL INVENTORY
  // =========================================================
  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const sheet = ss.getSheetByName(INVENTORY_SHEET);

    const rows = sheet.getDataRange().getValues();
    const cars = [];

    for (let i = 1; i < rows.length; i++) {
      const row = rows[i];

      if (!row[2] && !row[3]) continue;

      cars.push({
        id: row[1],
        brand: row[2],
        model: row[3],
        variant: row[4],
        price: row[5],
        color: row[6],
        year: row[7],
        fuel: row[8],
        km: row[9],
        owner: row[10],
        tpExpiry: formatSheetDate(row[11]),
        odExpiry: formatSheetDate(row[12]),
        idv: row[13],
        showroom: String(row[14]).toLowerCase().includes("yes"),
        images: row[15] || ""
      });
    }

    return jsonResponse({
      lastUpdated: new Date().toISOString(),
      cars: cars
    });

  } catch (err) {
    return jsonResponse({ error: err.toString() });
  }
}

// =========================================================
// HELPERS
